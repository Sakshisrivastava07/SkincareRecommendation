{
  "builds": [
    {
      "src": "skincareapi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "routes": [
    {
      "src": "/predict",
      "dest": "skincareapi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/skincare1.html"
    }
  ]
}